{
  "dependencies": {
    "hono": "^4.7.0",
    "unpdf": "^1.0.0",
    "zod": "^4.0.0"
  },
  "description": "Acuity tax planner on Cloudflare Workers: Hono API + Vite SPA static assets",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "name": "acuity-worker",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test:chat": "./node_modules/.bin/esbuild test/rulesChat.test.mts --bundle --platform=node --format=cjs --outfile=/tmp/rulesChat.test.cjs --log-level=error && node /tmp/rulesChat.test.cjs",
    "test:accuracy": "./node_modules/.bin/esbuild test/accuracyReview.test.mts --bundle --platform=node --format=cjs --outfile=/tmp/accuracyReview.test.cjs --log-level=error && node /tmp/accuracyReview.test.cjs",
    "test": "npm run test:chat && npm run test:accuracy"
  },
  "version": "1.0.0"
}